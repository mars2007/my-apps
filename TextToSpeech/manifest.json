{
  "manifest_version": 3,
  "name": "選択読み上げ（Web Speech）",
  "version": "1.2.0",
  "description": "選択テキスト／ページ全体をWeb Speech APIで読み上げます（ruby対応＋ハイライト付き）。",
  "action": { "default_popup": "popup.html", "default_title": "選択読み上げ" },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
